# Copy variables to .env file and fill it with your own values
# Don't use quotation marks, just write variables as plain text

# ============================================================
# JWT token
# ============================================================
SECRET_KEY=your_secret_jwt_key_here # Min. 32 bytes
ALGORITHM=hash_algorithm # HS256, HS384, HS512
ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=1

# ============================================================
# Default user credentials (seeded on database creation)
# ============================================================
SEED_USER_USERNAME=dev_username
SEED_USER_PASSWORD=dev_password

# ============================================================
# CORS origins - comma-separated list of allowed frontend origins
# (no trailing spaces)
# ============================================================
# LOCAL DEV (frontend running on your machine):
CORS_ORIGINS=http://localhost:5173

# CLOUD RUN (frontend deployed as a separate Cloud Run service):
# NOTE: Every Cloud Run service has its OWN unique URL.
# The frontend URL goes here, NOT the backend URL.
# Example:
# CORS_ORIGINS=https://gamma-frontend-xxxxx-uc.a.run.app
#
# Multiple origins are allowed (comma-separated):
# CORS_ORIGINS=http://localhost:5173,https://gamma-frontend-xxxxx-uc.a.run.app

# ============================================================
# Cookie settings
# ============================================================
# COOKIE_SAMESITE:
#   "lax"  - same-site only (local dev: localhost:5173 -> localhost:8000,
#            or custom domain pair like app.gamma.com -> api.gamma.com)
#   "none" - REQUIRED for Cloud Run: two default *.run.app services are
#            CROSS-SITE (run.app is a public suffix), so "lax" would
#            silently drop the refresh_token cookie on /api/refresh.
# COOKIE_SECURE:
#   "false" - local dev over plain HTTP (default)
#   "true"  - production / Cloud Run (HTTPS only). REQUIRED when COOKIE_SAMESITE=none.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ============================================================
# CLOUD RUN - set these in the Cloud Run service env vars:
# ============================================================
# CORS_ORIGINS=https://<frontend-service-url>.run.app
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# ============================================================
# CLOUD RUN Recommendations:
# ============================================================
# 1a. Set secret accessor permissions for your service account reponsible for cloud run deployments.  
# 1b. Set SEED_USER_PASSWORD and SECRET_KEY variables as secrets in secret manager,
#    then add them as reference to environment variables. All other variables set as
#    regular env vars in cloud run service.
# 2. To enforce security of backend, set it's authentication as:
#    "Require authentication"; "Identity and Access Management (IAM)".
#    This will cause your service to be unaccessible from the outside.
#    To access your backend service for debug purposes you just need to proxy it on local machine:
#    gcloud run services proxy service_name --port=8000 --region=europe-central2